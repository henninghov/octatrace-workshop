{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "First-channel frame vectors v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "frames",
    "invalid_frames"
  ],
  "properties": {
    "format": {
      "const": "octatrace-link-core-bluetooth-field-vectors"
    },
    "version": {
      "const": 1
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "flight",
          "message",
          "index",
          "frame"
        ],
        "properties": {
          "flight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "message": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2}){1,256}$"
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 21
          },
          "frame": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "invalid_frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      }
    }
  }
}
