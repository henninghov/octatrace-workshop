{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,"required":["revision","exchanges","find"],
  "properties":{
    "revision":{"const":1},
    "exchanges":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,"required":["case","route","hello","local","v1","reply","compatible"],
      "properties":{
        "case":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"},"route":{"enum":[1,2]},
        "hello":{"$ref":"#/$defs/control"},"local":{"type":"integer","minimum":0,"maximum":65535},
        "v1":{"type":"boolean"},"reply":{"anyOf":[{"$ref":"#/$defs/control"},{"type":"null"}]},"compatible":{"type":"boolean"}
      }
    }},
    "find":{"type":"object","additionalProperties":false,"required":["target","request","matched","ended"],
      "properties":{"target":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"request":{"$ref":"#/$defs/target"},"matched":{"$ref":"#/$defs/target"},"ended":{"$ref":"#/$defs/target"}}}
  },
  "$defs":{"control":{"type":"string","pattern":"^[0-9a-f]{24}$"},"target":{"type":"string","pattern":"^[0-9a-f]{40}$"}}
}
