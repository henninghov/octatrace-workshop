{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unauthenticated credential delivery progress",
  "type": "object", "additionalProperties": false,
  "required": ["v", "id", "ok", "type", "role", "build", "hardware", "boot", "state", "last_transfer", "transfer_id", "total", "received"],
  "properties": {
    "v": {"const": 1}, "id": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "ok": {"const": true}, "type": {"const": "credential_delivery_status"},
    "role": {"enum": ["Link", "Core"]}, "build": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hardware": {"type": "string", "pattern": "^(?!0{16}$)[0-9a-f]{16}$"},
    "boot": {"type": "string", "pattern": "^(?!0{32}$)[0-9a-f]{32}$"},
    "state": {"enum": ["idle", "receiving", "verifying", "verified", "failed"]},
    "last_transfer": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "transfer_id": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "total": {"type": "integer", "minimum": 0, "maximum": 271},
    "received": {"type": "integer", "minimum": 0, "maximum": 271}
  }
}
