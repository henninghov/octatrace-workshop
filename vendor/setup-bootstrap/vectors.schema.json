{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["revision","delivery","target","transfer","control","invalid","custody_body_hex","custody_sha256_of_body"],
  "properties":{
    "revision":{"const":1},"delivery":{"$ref":"#/$defs/uuid"},"target":{"$ref":"#/$defs/uuid"},
    "transfer":{"type":"integer","minimum":1,"maximum":65535},
    "control":{"type":"array","minItems":7,"uniqueItems":true,"items":{"type":"array","minItems":4,"maxItems":4,"prefixItems":[{"type":"string"},{"type":"integer","minimum":176,"maximum":180},{"type":"string"},{"type":"string","pattern":"^[0-9a-f]{40}$"}]}},
    "invalid":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]+$"}},
    "custody_body_hex":{"$ref":"#/$defs/hash"},"custody_sha256_of_body":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"uuid":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
